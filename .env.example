# Local development: copy to server/.env. No cloud account is required locally.
# In Vercel, connect Storage → Neon instead of pasting secrets into a file.
NODE_ENV=development
PORT=4000
APP_NAME=Qareeb
JWT_SECRET=local-development-only-change-this-for-production
JWT_EXPIRES_IN=30d

# HOSTED: Vercel Storage (Neon) usually injects POSTGRES_URL or DATABASE_URL.
# You can also paste any Postgres URL. Percent-encode special characters in the password.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
# POSTGRES_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# Optional image storage. If omitted, Vercel stores images in Postgres.
# SUPABASE_URL=https://PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=LEGACY_SERVICE_ROLE_KEY_SERVER_ONLY
# SUPABASE_STORAGE_BUCKET=qareeb-images

# LOCAL only: PostgreSQL-in-WASM (PGlite), never used on Vercel.
# LOCAL_DATABASE_PATH=./data/postgres
# UPLOADS_DIR=./uploads
AUTO_SEED=true
DEMO_PASSWORD=password123

# Optional Google login.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Optional Web Push: Vercel disables it unless both stable keys are set.
# VAPID_SUBJECT=mailto:you@example.com
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Only needed for deliberately cross-origin API clients, not the normal same-origin app.
# CORS_ORIGINS=https://your-app.example.com
