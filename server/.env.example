# Copy to server/.env for local development. No cloud account is required locally.
NODE_ENV=development
PORT=4000
APP_NAME=Qareeb

# Demo login shared by every seeded account: ali@demo.com / password123
DEMO_PASSWORD=password123
AUTO_SEED=true

# Signing secret for access/refresh tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=local-development-only-change-this-secret-before-production
JWT_EXPIRES_IN=30d

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local development needs nothing here: Qareeb boots PostgreSQL-in-WASM
# (PGlite) and stores it in server/data/postgres.
# LOCAL_DATABASE_PATH=./data/postgres

# Vercel: connect Storage -> Neon and the DATABASE_URL is injected for you.
# Any Postgres URL also works. Percent-encode special characters in passwords.
# DATABASE_URL=postgresql://user:password@host:5432/postgres?sslmode=require
# POSTGRES_URL=postgresql://user:password@host:5432/postgres?sslmode=require

# ---------------------------------------------------------------------------
# Payments — sandbox by default. Add keys to go live.
# ---------------------------------------------------------------------------
# JAZZCASH_MERCHANT_ID=
# JAZZCASH_PASSWORD=
# JAZZCASH_INTEGRITY_SALT=
# JAZZCASH_ENV=sandbox
# EASYPAISA_STORE_ID=
# EASYPAISA_HASH_KEY=
# EASYPAISA_ENV=sandbox

# ---------------------------------------------------------------------------
# Optional integrations
# ---------------------------------------------------------------------------
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# VAPID_SUBJECT=mailto:ops@qareeb.pk
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# CORS_ORIGINS=https://another-origin.example.com
